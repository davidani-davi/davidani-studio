# Shared password for team access (pick anything you want)
APP_PASSWORD=change-me-to-a-strong-password

# Signing secret for the auth cookie (32+ random chars)
AUTH_SECRET=please-change-me-to-a-long-random-string

# fal.ai API key — get it at https://fal.ai/dashboard/keys
FAL_KEY=fal-your-key-here

# Optional: enables V1.7 A/B daily + weekly report emails via Resend
RESEND_API_KEY=re_your_key_here
AB_REPORT_FROM="Davi Studio <reports@yourdomain.com>"

# Optional: lets Image Studio settle a garment's category from the ERP instead
# of inferring it from the photo (lib/erp-category.ts). Only the `category`
# field is read — never the free-text descr fields, which carry stale copy.
# Without these the studio works exactly as before, on vision inference.
# Same credential pair the ship-scanner's unattended jobs use.
ERP_USER_ID=your-erp-user-id
ERP_PASSWORD=your-erp-password
